#!/bin/sh
# Pre-commit hook: run lint-staged (eslint --fix + prettier) and gitleaks secret scan.
# gitleaks is optional locally; CI runs it on every push/PR via .github/workflows/secret-scan.yml.

scan_secrets() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --config .gitleaks.toml --no-banner
  elif [ -x "$HOME/.local/bin/gitleaks" ]; then
    "$HOME/.local/bin/gitleaks" protect --staged --redact --config .gitleaks.toml --no-banner
  else
    echo "hashwatch: gitleaks not found, skipping secret scan (install to ~/.local/bin/gitleaks)"
    return 0
  fi
}

scan_secrets || {
  echo "hashwatch: gitleaks detected a potential secret in staged changes."
  echo "Remove the secret before committing, or adjust .gitleaks.toml if it is a false positive."
  exit 1
}

npx lint-staged
